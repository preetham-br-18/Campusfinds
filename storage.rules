rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email in ['prajju.m016@gmail.com', 'admin@campusfind.edu'])
      );
    }

    // Item photo uploads (campus items)
    match /items/{itemId}/{allPaths=**} {
      // Anyone can view item photos
      allow read: if true;
      // Authenticated users can upload item images under 10MB
      allow write: if isAuthenticated() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() || isAdmin();
    }

    // User profile avatars
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // General fallback
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
